{
  "expo": {
    "name": "Javanese2000",
    "slug": "javanese2000",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#486344"
    },
    "assetBundlePatterns": [
      "assets/reader/**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#486344"
      },
      "package": "com.curioussheva.javanese2000"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2718792162592521~8055554493",
          "iosAppId": "ca-app-pub-2718792162592521~8055554493",
          "delayAppMeasurementInit": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "0ea0f8dc-2e0f-485e-95a7-1cd6e0664dcb"
      }
    }
  }
}
 